# ── Core ──────────────────────────────────────────────────────────────
# 32+ random bytes. Signs session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts OAuth tokens and MFA secrets at rest (AES-256-GCM). REQUIRED in production.
ENCRYPTION_KEY=change-me-to-another-long-random-string
# Demo mode seeds Smith Family Farms, shows demo sign-in shortcuts and the demo MFA code helper.
FABRIK_DEMO_MODE=true
# Anchors "today" for the seeded demo so the Expo story is stable (YYYY-MM-DD). Leave empty for real time.
FABRIK_CLOCK=2026-10-16
# Where the local JSON datastore and uploaded documents live.
FABRIK_DATA_DIR=.data

# ── QuickBooks Online (live OAuth; optional — demo uses the synthetic sandbox provider) ──
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/v1/integrations/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# ── FabrikIDP document intelligence (optional — local text extractor is used when unset) ──
FABRIKIDP_URL=
FABRIKIDP_API_KEY=

# ── LLM gateway (optional — deterministic grounded engine is used when unset) ──
ANTHROPIC_API_KEY=
FABRIK_LLM_MODEL=claude-opus-5-5
